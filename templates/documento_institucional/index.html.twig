{% extends 'base.html.twig' %}

{% block title %}Transparencia y Documentación Institucional{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Transparencia y Documentación Institucional</h1>
        <p class="text-muted">Accedé a nuestros estatutos, memorias, balances y constancias oficiales.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    {% for doc in documento_institucionals %}
        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex align-items-center mb-3">
<div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
    <i class="fa-solid fa-file-pdf fa-2x"></i>
</div>
                        <div>
                            <span class="badge bg-light text-secondary border mb-1">Documento PDF</span>
                            <h5 class="card-title fw-semibold text-dark mb-0">{{ doc.nombre }}</h5>
                        </div>
                    </div>

                    <p class="card-text text-muted small flex-grow-1">
                        {{ doc.descripcion ?: 'Documentación oficial disponible para consulta pública.' }}
                    </p>

                    <div class="pt-3 border-top d-flex gap-2">
                        <a href="{{ asset('uploads/documentos/' ~ doc.archivo) }}" target="_blank" class="btn btn-outline-primary btn-sm flex-fill">
                            Ver PDF
                        </a>
                        <a href="{{ asset('uploads/documentos/' ~ doc.archivo) }}" download class="btn btn-primary btn-sm flex-fill">
                            Descargar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="alert alert-light text-center border py-5">
                <i class="bi bi-folder-x fs-1 text-muted d-block mb-2"></i>
                <p class="mb-0 text-muted">No hay documentos cargados en este momento.</p>
            </div>
        </div>
    {% endfor %}
    </div>
</div>
{% endblock %}
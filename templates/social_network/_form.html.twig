{# templates/social_network/_form.html.twig #}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        {# Errores generales del formulario #}
        {{ form_errors(form) }}

        <div class="row g-3">
            {# Nombre y Enlace #}
            <div class="col-md-6">
                {{ form_row(form.nombre) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.url) }}
            </div>

            {# Ícono y Orden #}
            <div class="col-md-6">
                {{ form_row(form.icono) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.ordenVisualizacion) }}
            </div>

            {# Switch de Estado Activo #}
            <div class="col-12 mt-2">
                <div class="form-check form-switch">
                    {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(form.isActive, null, {'label_attr': {'class': 'form-check-label fw-semibold'}}) }}
                    {{ form_errors(form.isActive) }}
                </div>
            </div>
        </div>

        <hr class="my-4 text-muted">

        {# Botones de Guardar y Cancelar #}
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('app_social_network_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-circle me-1"></i> {{ button_label|default('Guardar cambios') }}
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
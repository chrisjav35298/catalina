<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Metaetiquetas para SEO -->
    <meta name="description" content="Fundación Santa Catalina - Trabajamos para el bienestar de las mascotas y la comunidad en la provincia del Chaco, Argentina.">
    <meta name="keywords" content="fundación, mascotas, adopción, bienestar animal, ayuda, rescate, Chaco, Argentina">
    <meta name="author" content="Fundación Santa Catalina">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph para compartir en redes sociales -->
    <meta property="og:title" content="Fundación Santa Catalina">
    <meta property="og:description" content="Únete a nuestra causa y ayúdanos a mejorar la vida de los animales necesitados en Chaco, Argentina.">
    <meta property="og:image" content="{{ asset('img/logoCanva.png') }}">
    <meta property="og:url" content="{{ path('app_home') }}">
    <meta property="og:type" content="website">
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Fundación Santa Catalina">
    <meta name="twitter:description" content="Trabajamos para el bienestar de los animales y la comunidad en Chaco, Argentina.">
    <meta name="twitter:image" content="{{ asset('img/logoCanva.png') }}">
    
    <title>{% block title %}Fundación Mascotas{% endblock %}</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    
    <!-- Estilos personalizados -->
    {% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
    {% endblock %}
</head>

{% block header %}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <!-- Logo con imagen -->
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <img src="{{ asset('img/logoCanva.png') }}" alt="Fundación Sta Catalina" height="40" style="border-radius: 50%;  position: relative; left: -10px;">Fundación Santa Catalina
        </a>

        <!-- Botón para colapsar navbar -->
        {# <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button> #}
    </div>
</nav>
{% endblock %}


<body>
    {% block body %}{% endblock %}

    <!-- Bootstrap JS y Popper -->
    <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>

    {% block javascripts %}{% endblock %}
</body>
{% block footer %}

    <!-- Footer -->
    <footer class="bg-dark text-center py-5 mt-5">

        <p class="text-white mb-2">
            &copy; {{ "now"|date("Y") }} Fundación Santa Catalina.
            Todos los derechos reservados.
        </p>

        <!-- Teléfono de contacto -->
        {% if config.telefonoContacto %}
            <p class="text-white mb-4">
                <i class="fas fa-phone-alt me-2"></i>
                <a href="tel:{{ config.telefonoContacto|replace({' ': '', '-': ''}) }}"
                   class="text-white text-decoration-none">
                    {{ config.telefonoContacto }}
                </a>
            </p>
        {% endif %}

        <div class="d-flex justify-content-center align-items-center flex-wrap gap-3">

            <!-- Redes sociales -->
            {% for red in redesSociales|default([]) %}
                <a href="{{ red.url }}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-white text-decoration-none fs-4"
                   title="{{ red.nombre }}"
                   aria-label="{{ red.nombre }}">

                    {% if red.icono %}
                        <i class="{{ red.icono }}"></i>
                    {% else %}
                        <span class="badge bg-secondary">
                            {{ red.nombre }}
                        </span>
                    {% endif %}

                </a>
            {% endfor %}


            <!-- Documentación Institucional -->
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_DOCUMENTOS_INSTITUCIONALES') %}

                {# Usuario autorizado: acceso directo #}
                <a href="{{ path('app_documento_institucional_index') }}"
                   class="btn btn-outline-light btn-sm d-inline-flex align-items-center">

                    <i class="fa-solid fa-file-lines me-2 text-warning"></i>
                    Documentación Institucional

                </a>

            {% else %}

                {# Usuario no autorizado: mostrar modal de login #}
                <button type="button"
                        class="btn btn-outline-light btn-sm d-inline-flex align-items-center"
                        data-bs-toggle="modal"
                        data-bs-target="#modalLoginDocumentos">

                    <i class="fa-solid fa-file-lines me-2 text-warning"></i>
                    Documentación Institucional

                </button>

            {% endif %}

        </div>
    </footer>


    {# ============================================================
       MODAL DE ACCESO A DOCUMENTACIÓN INSTITUCIONAL
       Solo se muestra para usuarios sin los roles correspondientes.
       ============================================================ #}

    {% if not is_granted('ROLE_ADMIN') and not is_granted('ROLE_DOCUMENTOS_INSTITUCIONALES') %}

        <div class="modal fade"
             id="modalLoginDocumentos"
             tabindex="-1"
             aria-labelledby="modalLoginDocumentosLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <!-- Header -->
                    <div class="modal-header">

                        <h5 class="modal-title text-dark"
                            id="modalLoginDocumentosLabel">

                            <i class="fa-solid fa-lock me-2 text-dark"></i>
                            Acceso restringido

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>

                    </div>


                    <!-- Formulario de login -->
                    <form method="post"
                          action="{{ path('app_login') }}">

                        <input type="hidden"
                               name="_login_context"
                               value="documentos">

                        <input type="hidden"
                               name="_return_url"
                               value="{{ app.request.uri }}">

                        <input type="hidden"
                               name="_target_path"
                               value="{{ path('app_documento_institucional_index') }}">


                        <!-- Body -->
                        <div class="modal-body">

                            {% if app.request.query.get('documentos_login_error') %}

                                <div class="alert alert-danger">
                                    Las credenciales ingresadas no son correctas.
                                </div>

                            {% endif %}

                            <p class="text-muted mb-4">
                                Ingrese sus credenciales para acceder a la
                                documentación institucional.
                            </p>


                            <!-- Email -->
                            <div class="mb-3 text-start">

                                <label for="modal_email"
                                       class="form-label">
                                    Email
                                </label>

                                <input type="email"
                                       class="form-control"
                                       id="modal_email"
                                       name="_username"
                                       required
                                       autocomplete="username">

                            </div>


                            <!-- Contraseña -->
                            <div class="mb-3 text-start">

                                <label for="modal_password"
                                       class="form-label">
                                    Contraseña
                                </label>

                                <input type="password"
                                       class="form-control"
                                       id="modal_password"
                                       name="_password"
                                       required
                                       autocomplete="current-password">

                            </div>

                        </div>


                        <!-- Footer del modal -->
                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Cancelar
                            </button>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="fa-solid fa-right-to-bracket me-1"></i>
                                Iniciar sesión

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    {% endif %}


    {# ============================================================
       Volver a abrir el modal cuando el login falla
       ============================================================ #}

    {% if app.request.query.get('documentos_login_error') %}

        <script>
            document.addEventListener('DOMContentLoaded', function () {

                const modalElement = document.getElementById('modalLoginDocumentos');

                if (modalElement) {
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();
                }

            });
        </script>

    {% endif %}

{% endblock %}

</html>
